# 复制为 .env 后按需修改。.env 已被 gitignore，不要提交真实密钥。

# ---- 运行环境 ----
ROBOT_AGENT_ENV=dev
ROBOT_AGENT_LOG_LEVEL=INFO
ROBOT_AGENT_LOG_JSON=true

# ---- 执行器 ----
# mock：无需 ROS，本地/CI 可用｜ros2：需要 source ROS2 环境与 Gazebo
ROBOT_AGENT_EXECUTOR__BACKEND=mock
ROBOT_AGENT_EXECUTOR__STEP_TIMEOUT_S=90
ROBOT_AGENT_EXECUTOR__MAX_ATTEMPTS=2
# ROBOT_AGENT_EXECUTOR__ROS_DOMAIN_ID=42

# ---- LLM 规划（可选，不配也能跑规则规划）----
# ROBOT_AGENT_LLM__API_KEY=sk-xxx
# ROBOT_AGENT_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ROBOT_AGENT_LLM__MODEL=qwen-plus
ROBOT_AGENT_LLM__TIMEOUT_S=20
ROBOT_AGENT_LLM__FALLBACK_TO_RULES=true

# ---- 安全 ----
ROBOT_AGENT_SAFETY__MAX_LINEAR_SPEED=0.22
ROBOT_AGENT_SAFETY__MAX_STEPS=8
# ROBOT_AGENT_SAFETY__REQUIRE_APPROVAL_FOR=["push_cube"]

# ---- 存储与审计 ----
ROBOT_AGENT_STORAGE__URL=sqlite:///var/tasks.db
ROBOT_AGENT_AUDIT__ENABLED=true
ROBOT_AGENT_AUDIT__PATH=var/audit/audit.jsonl

# ---- HTTP 控制面 ----
ROBOT_AGENT_API__HOST=127.0.0.1
ROBOT_AGENT_API__PORT=8080
# 非本机监听时必填，否则 prod 校验会拒绝启动
# ROBOT_AGENT_API__AUTH_TOKEN=change-me
